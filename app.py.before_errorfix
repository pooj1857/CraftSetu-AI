@app.route("/learn", methods=["GET", "POST"])
def learn():
    learner = current_learner()
    selected_slug = request.values.get("craft", "madhubani")
    selected = CRAFT_BY_SLUG.get(selected_slug, CRAFTS[0])
    language = request.values.get("language", "English")
    if language not in ("English", "Hindi", "Gujarati"):
        language = "English"
    with get_db() as db:
        saved = db.execute("SELECT * FROM learning_progress WHERE learner_name=? AND craft_slug=?", (learner, selected["slug"])).fetchone()
    progress = dict(saved) if saved else {"current_step": 0, "completed": 0, "notes": "", "language": language}
    return render_template("learn.html", selected=selected, progress=progress, language=language)

@app.route("/api/ask", methods=["POST"])
def api_ask():
    data = request.get_json(silent=True) or {}
    question = str(data.get("question", "")).strip()
    slug = str(data.get("craft", "")).strip()
    language = str(data.get("language", "English")).strip()
    learner = current_learner()
    if slug not in CRAFT_BY_SLUG:
        return jsonify(error="Please select a valid craft."), 400
    if not question or len(question) > 1500:
        return jsonify(error="Enter a question of 1–1500 characters."), 400
    if language not in ("English", "Hindi", "Gujarati"):
        language = "English"
    api_key = os.getenv("GEMINI_API_KEY", "").strip()
    if not api_key:
        return jsonify(error="Gemini is not configured yet. Add GEMINI_API_KEY to your .env file and restart the app."), 503
    craft = CRAFT_BY_SLUG[slug]
    prompt = f"""You are CraftSetu AI, a careful educator of diverse Indian traditional crafts.
Answer the learner's question about {craft['name']} ({craft['region']}) in {language}.
Craft context: {craft['history']} Materials: {craft['materials']} Cultural significance: {craft['significance']}.
Give practical, respectful, beginner-friendly guidance. Clearly flag hazardous tasks (kiln firing, metal casting, stone carving, sharp tools) as tasks requiring trained adult/artisan supervision and proper protective equipment. Do not invent historical facts; note uncertainty when needed.
Learner question: {question}"""
    try:
        from google import genai
        client = genai.Client(api_key=api_key)
        response = client.models.generate_content(model=os.getenv("GEMINI_MODEL", "gemini-3.8-flash"), contents=prompt)
        answer = (getattr(response, "text", None) or "").strip()
        if not answer:
            raise RuntimeError("The AI returned an empty response.")
        return jsonify(answer=answer)

    except Exception as exc:
        app.logger.exception("Gemini quiz generation failed")
        return jsonify(
            error=f"{type(exc).__name__}: {exc}"
        ), 502


@app.route("/api/progress", methods=["POST"])
def save_progress():
    data = request.get_json(silent=True) or {}
    learner = current_learner()
    slug = str(data.get("craft", "")).strip()
    language = str(data.get("language", "English")).strip()
    try:
        step = max(0, min(100, int(data.get("step", 0))))
    except (ValueError, TypeError):
        step = 0
    completed = 1 if data.get("completed") else 0
    notes = str(data.get("notes", ""))[:2000]
    if slug not in CRAFT_BY_SLUG:
        return jsonify(error="Please select a valid craft."), 400
    if language not in ("English", "Hindi", "Gujarati"):
        language = "English"
    with get_db() as db:
        db.execute("""INSERT INTO learning_progress(learner_name,craft_slug,language,current_step,completed,notes,updated_at)
        VALUES(?,?,?,?,?,?,?) ON CONFLICT(learner_name,craft_slug) DO UPDATE SET
        language=excluded.language,current_step=excluded.current_step,completed=excluded.completed,notes=excluded.notes,updated_at=excluded.updated_at""",
        (learner, slug, language, step, completed, notes, datetime.now().isoformat(timespec="seconds")))
        if completed:
            db.execute("INSERT OR IGNORE INTO achievements(learner_name,badge_key,title,description,earned_at) VALUES(?,?,?,?,?)",
                       (learner, "first-completion-" + slug, "Craft Explorer: " + CRAFT_BY_SLUG[slug]["name"], "Completed a craft learning path.", datetime.now().isoformat(timespec="seconds")))
    return jsonify(ok=True, message="Progress saved.")


