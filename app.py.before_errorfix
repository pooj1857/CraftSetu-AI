def get_db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


def init_db():
    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)

    # Safely migrate the older crafts table without deleting its data.
    with get_db() as db:
        table_exists = db.execute("""
            SELECT name FROM sqlite_master
            WHERE type = 'table' AND name = 'crafts'
        """).fetchone()

        if table_exists:
            columns = {
                row["name"]
                for row in db.execute("PRAGMA table_info(crafts)").fetchall()
            }

            if "slug" not in columns:
                db.execute("ALTER TABLE crafts ADD COLUMN slug TEXT")
            if "significance" not in columns:
                db.execute("ALTER TABLE crafts ADD COLUMN significance TEXT")
            if "level" not in columns:
                db.execute("ALTER TABLE crafts ADD COLUMN level TEXT")

            known_crafts = {
                craft["name"].casefold(): craft
                for craft in CRAFTS
            }

            existing_crafts = db.execute(
                "SELECT id, name, slug FROM crafts ORDER BY id"
            ).fetchall()

            used_slugs = set()

            for row in existing_crafts:
                craft = known_crafts.get(row["name"].casefold())

                if craft:
                    slug = craft["slug"]
                else:
                    slug = row["slug"] or f"legacy-{row['id']}"

                if slug in used_slugs:
                    slug = f"{slug}-{row['id']}"

                used_slugs.add(slug)

                if craft:
                    db.execute("""
                        UPDATE crafts
                        SET slug = ?,
                            significance = COALESCE(significance, ''),
                            level = COALESCE(level, 'Beginner')
                        WHERE id = ?
                    """, (slug, row["id"]))
                else:
                    db.execute("""
                        UPDATE crafts
                        SET slug = ?,
                            significance = COALESCE(
                                significance, cultural_significance,
                                description, ''
                            ),
                            level = COALESCE(level, 'Beginner')
                        WHERE id = ?
                    """, (slug, row["id"]))

            db.execute("""
                CREATE UNIQUE INDEX IF NOT EXISTS idx_crafts_slug
                ON crafts(slug)
            """)

    with get_db() as db:

        db.executescript("""
        CREATE TABLE IF NOT EXISTS crafts (
            id INTEGER PRIMARY KEY AUTOINCREMENT, slug TEXT UNIQUE NOT NULL, name TEXT NOT NULL,
            region TEXT NOT NULL, category TEXT NOT NULL, history TEXT NOT NULL, materials TEXT NOT NULL,
            significance TEXT NOT NULL, level TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS learning_progress (
            id INTEGER PRIMARY KEY AUTOINCREMENT, learner_name TEXT NOT NULL, craft_slug TEXT NOT NULL,
            language TEXT NOT NULL DEFAULT 'English', current_step INTEGER NOT NULL DEFAULT 0,
            completed INTEGER NOT NULL DEFAULT 0, notes TEXT NOT NULL DEFAULT '',
            updated_at TEXT NOT NULL, UNIQUE(learner_name, craft_slug),
            FOREIGN KEY(craft_slug) REFERENCES crafts(slug)
        );
        CREATE TABLE IF NOT EXISTS quiz_questions (
            id INTEGER PRIMARY KEY AUTOINCREMENT, craft_slug TEXT NOT NULL, difficulty TEXT NOT NULL,
            question TEXT NOT NULL, options_json TEXT NOT NULL, answer_index INTEGER NOT NULL,
            explanation TEXT NOT NULL, FOREIGN KEY(craft_slug) REFERENCES crafts(slug)
        );
        CREATE TABLE IF NOT EXISTS quiz_attempts (
            id INTEGER PRIMARY KEY AUTOINCREMENT, learner_name TEXT NOT NULL, craft_slug TEXT NOT NULL,
            difficulty TEXT NOT NULL, score INTEGER NOT NULL, total INTEGER NOT NULL,
            percentage REAL NOT NULL, answers_json TEXT NOT NULL, created_at TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS generated_quizzes (
            quiz_id TEXT PRIMARY KEY, learner_name TEXT NOT NULL, craft_slug TEXT NOT NULL,
            difficulty TEXT NOT NULL, language TEXT NOT NULL, created_at TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS generated_quiz_questions (
            id INTEGER PRIMARY KEY AUTOINCREMENT, quiz_id TEXT NOT NULL,
            question_number INTEGER NOT NULL, question TEXT NOT NULL,
            options_json TEXT NOT NULL, answer_index INTEGER NOT NULL,
            explanation TEXT NOT NULL,
            FOREIGN KEY(quiz_id) REFERENCES generated_quizzes(quiz_id) ON DELETE CASCADE,
            UNIQUE(quiz_id, question_number)
        );
        CREATE TABLE IF NOT EXISTS achievements (
            id INTEGER PRIMARY KEY AUTOINCREMENT, learner_name TEXT NOT NULL, badge_key TEXT NOT NULL,
            title TEXT NOT NULL, description TEXT NOT NULL, earned_at TEXT NOT NULL,
            UNIQUE(learner_name, badge_key)
        );
        """)
        for craft in CRAFTS:
            db.execute("""INSERT INTO crafts(slug,name,region,category,history,materials,significance,level)
            VALUES(:slug,:name,:region,:category,:history,:materials,:significance,:level)
            ON CONFLICT(slug) DO UPDATE SET name=excluded.name, region=excluded.region, category=excluded.category,
            history=excluded.history, materials=excluded.materials, significance=excluded.significance, level=excluded.level""", craft)
        count = db.execute("SELECT COUNT(*) FROM quiz_questions").fetchone()[0]
        if count == 0:
            questions = [
                ("madhubani","Beginner","Madhubani painting is associated with which region?",["Mithila","Kutch","Malabar","Konkan"],0,"Madhubani painting is strongly associated with the Mithila region of Bihar."),
                ("blue-pottery","Beginner","Which colour is especially associated with Jaipur blue pottery?",["Blue","Neon green","Black only","Orange only"],0,"Blue designs are a well-known feature of Jaipur blue pottery."),
                ("bamboo-cane","Beginner","Which material is central to bamboo and cane craft?",["Bamboo and cane","Granite","Copper wire only","Silk thread only"],0,"Artisans weave and shape prepared bamboo and cane."),
                ("dhokra","Intermediate","Dhokra casting is associated with which process?",["Lost-wax casting","Glass blowing","Paper folding","Block printing"],0,"Dhokra is a traditional metal casting practice using lost-wax methods."),
                ("wood-carving","Beginner","What is a key tool for wood carving?",["Carving chisel","Potter's wheel only","Loom shuttle","Kiln shelf"],0,"Carving chisels help remove wood carefully to form designs."),
                ("stone-carving","Intermediate","What should be used when carving stone?",["Eye and dust protection","No safety equipment","Bare hands only","A paint brush only"],0,"Stone work can create flying chips and dust, so proper protective equipment is important."),
                ("warli","Beginner","Warli art often builds figures from which shapes?",["Simple geometric shapes","Photographic gradients","Metal wires","Mosaic glass only"],0,"Warli figures commonly use circles, triangles and lines."),
                ("terracotta","Beginner","Terracotta objects are made mainly from what?",["Clay","Wool","Bamboo leaves","Silver"],0,"Terracotta is shaped clay that is fired to harden."),
                ("madhubani","Intermediate","Which subject often appears in Madhubani art?",["Nature and stories","Only modern cars","Only computer code","Only maps"],0,"Nature, stories, ritual themes and community life are common motifs."),
                ("bamboo-cane","Intermediate","Why is bamboo often valued as a craft material?",["It is versatile and renewable when responsibly managed","It cannot bend","It is always metal","It needs no skill"],0,"Bamboo is versatile; responsible harvesting matters for sustainability.")
            ]
            for slug, diff, q, opts, ans, exp in questions:
                db.execute("INSERT INTO quiz_questions(craft_slug,difficulty,question,options_json,answer_index,explanation) VALUES(?,?,?,?,?,?)",
                           (slug,diff,q,json.dumps(opts),ans,exp))

