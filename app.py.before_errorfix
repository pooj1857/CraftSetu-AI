@app.route("/api/quiz/generate", methods=["POST"])
def generate_quiz():
    data = request.get_json(silent=True) or {}
    learner = current_learner()
    craft_slug = str(data.get("craft_slug", "")).strip()
    difficulty = str(data.get("difficulty", "")).title().strip()
    language = str(data.get("language", "English")).strip()

    if craft_slug not in CRAFT_BY_SLUG:
        return jsonify(error="Please select a valid craft."), 400
    if difficulty not in ("Beginner", "Intermediate", "Advanced"):
        return jsonify(error="Please select a valid difficulty."), 400
    if language not in ("English", "Hindi", "Gujarati"):
        return jsonify(error="Please select a valid language."), 400

    api_key = os.getenv("GEMINI_API_KEY", "").strip()
    if not api_key:
        return jsonify(error="Gemini API key is missing. Add GEMINI_API_KEY to your .env file and restart CraftSetu AI."), 503

    craft = CRAFT_BY_SLUG[craft_slug]
    prompt = f"""You are CraftSetu AI, an accurate teacher of Indian traditional crafts.
Create exactly 10 multiple-choice quiz questions about {craft["name"]} from {craft["region"]}.
Difficulty: {difficulty}. Language: {language}.
Craft context: {craft["history"]} Materials: {craft["materials"]} Cultural significance: {craft["significance"]}.
Rules:
- Write every question, all four options, and explanation in {language}.
- Each question must have exactly four distinct options.
- Include exactly one correct option.
- answer_index must be a zero-based integer (0, 1, 2, or 3) pointing to the correct option.
- Make questions specific to the selected craft and chosen difficulty.
- Avoid repeating questions or making up uncertain historical claims.
- For safety-related crafts, include responsible safety knowledge where relevant.
Return only valid JSON in this exact shape, with no Markdown fences or extra text:
{{"questions":[{{"question":"Question text","options":["Option A","Option B","Option C","Option D"],"answer_index":0,"explanation":"Short explanation"}}]}}"""

    try:
        from google import genai
        client = genai.Client(api_key=api_key)
        response = client.models.generate_content(
            model=os.getenv("GEMINI_MODEL", "gemini-2.5-flash"),
            contents=prompt,
            config={"response_mime_type": "application/json"}
        )
        raw_text = (getattr(response, "text", None) or "").strip()
        if not raw_text:
            raise ValueError("Gemini returned an empty response.")
        if raw_text.startswith("```"):
            raw_text = re.sub(r"^```(?:json)?\s*|\s*```$", "", raw_text, flags=re.IGNORECASE).strip()
        parsed = json.loads(raw_text)
        generated = parsed.get("questions") if isinstance(parsed, dict) else None
        if not isinstance(generated, list) or len(generated) < 10:
            raise ValueError("Gemini did not return exactly 10 quiz questions.")

        cleaned = []
        for item in generated[:10]:
            if not isinstance(item, dict):
                continue
            question_text = str(item.get("question", "")).strip()
            options = item.get("options")
            explanation = str(item.get("explanation", "")).strip()
            answer_index = item.get("answer_index")
            if (not question_text or not isinstance(options, list) or len(options) != 4
                    or not all(isinstance(option, str) and option.strip() for option in options)
                    or isinstance(answer_index, bool) or not isinstance(answer_index, int)
                    or answer_index not in range(4)):
                continue
            cleaned.append({
                "question": question_text[:1000],
                "options": [option.strip()[:300] for option in options],
                "answer_index": answer_index,
                "explanation": explanation[:1000]
            })
        if len(cleaned) < 10:
            raise ValueError(
                f"Gemini returned only {len(cleaned)} valid questions. Exactly 10 are required."
                )

        quiz_id = uuid.uuid4().hex
        now = datetime.now().isoformat(timespec="seconds")
        with get_db() as db:
            db.execute("""INSERT INTO generated_quizzes
                (quiz_id, learner_name, craft_slug, difficulty, language, created_at)
                VALUES (?, ?, ?, ?, ?, ?)""",
                (quiz_id, learner, craft_slug, difficulty, language, now))
            visible_questions = []
            for number, item in enumerate(cleaned, start=1):
                cursor = db.execute("""INSERT INTO generated_quiz_questions
                    (quiz_id, question_number, question, options_json, answer_index, explanation)
                    VALUES (?, ?, ?, ?, ?, ?)""",
                    (quiz_id, number, item["question"], json.dumps(item["options"], ensure_ascii=False),
                     item["answer_index"], item["explanation"]))
                visible_questions.append({
                    "id": cursor.lastrowid,
                    "number": number,
                    "question": item["question"],
                    "options": item["options"]
                })
        return jsonify(quiz_id=quiz_id, craft_name=craft["name"], difficulty=difficulty,
                       language=language, questions=visible_questions)
    except Exception:
        app.logger.exception("Gemini quiz generation failed")
        return jsonify(error="Gemini could not generate the quiz right now. Check your API key, model, internet connection, and quota, then try again."), 502


@app.route("/api/quiz/submit", methods=["POST"])
def submit_quiz():
    data = request.get_json(silent=True) or {}

    learner = current_learner()
    answers = data.get("answers", {})
    craft_slug = str(data.get("craft_slug", "")).strip()
    difficulty = str(data.get("difficulty", "")).title()
    language = str(data.get("language", "English")).strip()

    if craft_slug not in CRAFT_BY_SLUG:
        return jsonify(error="Please select a valid craft."), 400

    if difficulty not in ("Beginner", "Intermediate", "Advanced"):
        return jsonify(error="Please select a valid difficulty."), 400

    if language not in ("English", "Hindi", "Gujarati"):
        return jsonify(error="Please select a valid language."), 400

    if not isinstance(answers, dict):
        return jsonify(error="Invalid answers submitted."), 400

    with get_db() as db:
        rows = db.execute("""
            SELECT * FROM quiz_questions
            WHERE craft_slug = ? AND difficulty = ?
            ORDER BY id
        """, (craft_slug, difficulty)).fetchall()

        if not rows:
            return jsonify(
                error="No questions are available for this craft and difficulty yet."
            ), 400

        result = []
        score = 0

        for row in rows:
            selected = answers.get(str(row["id"]))

            valid_selection = (
                isinstance(selected, int)
                and not isinstance(selected, bool)
                and 0 <= selected < len(json.loads(row["options_json"]))
            )

            correct = (
                valid_selection
                and selected == row["answer_index"]
            )

            score += int(correct)
            options = json.loads(row["options_json"])

            result.append({
                "id": row["id"],
                "question": row["question"],
                "correct": correct,
                "selected": selected if valid_selection else None,
                "answer_index": row["answer_index"],
                "answer": options[row["answer_index"]],
                "explanation": row["explanation"]
            })

        total = len(rows)
        percentage = round(score / total * 100, 1)

        db.execute("""
            INSERT INTO quiz_attempts
            (learner_name, craft_slug, difficulty, score, total,
             percentage, answers_json, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            learner,
            craft_slug,
            difficulty,
            score,
            total,
            percentage,
            json.dumps(answers),
            datetime.now().isoformat(timespec="seconds")
        ))

        if percentage >= 70:
            db.execute("""
                INSERT OR IGNORE INTO achievements
                (learner_name, badge_key, title, description, earned_at)
                VALUES (?, ?, ?, ?, ?)
            """, (
                learner,
                "quiz-bronze",
                "Craft Quiz Star",
                "Scored at least 70% on a craft quiz.",
                datetime.now().isoformat(timespec="seconds")
            ))

    return jsonify(
        score=score,
        total=total,
        percentage=percentage,
        results=result
    )


@app.route("/my-learning", methods=["GET", "POST"])
def my_learning():
    if request.method == "POST":
        name = request.form.get("learner_name", "").strip()
        if name:
            session["learner_name"] = name[:60]
            flash("Your learner profile has been updated.", "success")
        return redirect(url_for("my_learning"))
    learner = current_learner()
    with get_db() as db:
        progress_rows = db.execute("""SELECT lp.*, c.name, c.region FROM learning_progress lp JOIN crafts c ON c.slug=lp.craft_slug
        WHERE lp.learner_name=? ORDER BY lp.updated_at DESC""", (learner,)).fetchall()
        attempts = db.execute("SELECT * FROM quiz_attempts WHERE learner_name=? ORDER BY created_at DESC LIMIT 8", (learner,)).fetchall()
        badges = db.execute("SELECT * FROM achievements WHERE learner_name=? ORDER BY earned_at DESC", (learner,)).fetchall()
    return render_template("my_learning.html", learner=learner, progress_rows=progress_rows, attempts=attempts, badges=badges)

